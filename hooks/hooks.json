{
  "description": "Keeps /onyo-mode on for the rest of the session once typed. /onyo-mode off turns it off. OSTACK_ONYO_MODE=on starts every session with it on.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/onyo-mode-toggle.sh expansion" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/onyo-mode-toggle.sh submit" }
        ]
      }
    ]
  }
}
